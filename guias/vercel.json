{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/interes-compuesto", "destination": "/interes-compuesto.html" },
    { "source": "/hipoteca", "destination": "/hipoteca.html" },
    { "source": "/objetivo-ahorro", "destination": "/objetivo-ahorro.html" },
    { "source": "/prestamo", "destination": "/prestamo.html" },
    { "source": "/deposito", "destination": "/deposito.html" },
    { "source": "/coche", "destination": "/coche.html" },
    { "source": "/independizarse", "destination": "/independizarse.html" },
    { "source": "/fondo-emergencia", "destination": "/fondo-emergencia.html" },
    { "source": "/regla-50-30-20", "destination": "/regla-50-30-20.html" },
    { "source": "/comprar-casa", "destination": "/comprar-casa.html" },
    { "source": "/sobre-cuentas-claras", "destination": "/sobre-cuentas-claras.html" },
    { "source": "/aviso-legal", "destination": "/aviso-legal.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/guias/interes-compuesto", "destination": "/guias/interes-compuesto.html" },
    { "source": "/guias/hipoteca", "destination": "/guias/hipoteca.html" },
    { "source": "/guias/fondo-emergencia", "destination": "/guias/fondo-emergencia.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
